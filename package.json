{
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.cjs",
    "build": "vite build",
    "audio:audit": "node scripts/audit-runtime-audio.mjs --label before",
    "audio:audit:runtime": "node scripts/audit-runtime-audio.mjs --root assets/sounds --report-root source-assets/audio/runtime-sources/reports --label after",
    "audio:normalize": "node scripts/normalize-runtime-audio.mjs",
    "preview": "vite preview",
    "check": "node scripts/check-project.mjs && node --test tests/*.test.mjs",
    "textures": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/generate-runtime-textures.ps1",
    "textures:all": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/generate-runtime-textures.ps1 -All",
    "stamp-modules": "node scripts/stamp-module-revision.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "basisu": "^1.16.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "postprocessing": "^6.36.3",
    "realism-effects": "^1.1.2",
    "three": "^0.165.0"
  }
}
